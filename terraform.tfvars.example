# Example terraform.tfvars
# Copy this to terraform.tfvars and fill in your values.

# Azure region
# location = "eastus"

# Resource group name
# resource_group_name = "rg-coding-agent"

# VM size. B2ms = 2 vCPU, 8GB RAM ($46/mo)
# vm_size = "Standard_B2ms"

# VM name
# vm_name = "vm-coding-agent"

# Admin username
# admin_username = "agent"

# Path to your SSH public key
# ssh_public_key_path = "~/.ssh/id_rsa.pub"

# Lock SSH access to your corporate VPN egress IP
# Find it with: curl ifconfig.me
# ssh_allowed_ip = "203.0.113.42/32"

# Set to false if you access via corporate VPN / Azure Bastion (private IP only)
# create_public_ip = true

# OS disk size (64GB+ recommended for Docker images + monorepos)
# disk_size_gb = 64

# Additional data disk for Docker storage (0 to skip)
# docker_disk_size_gb = 32

# Custom Ubuntu version if needed
# ubuntu_version = "22_04-lts"

# ──────────────────────────────────────────────────────────────────
# Cloudflare Tunnel (Zero Inbound Ports)
# ──────────────────────────────────────────────────────────────────
# If set, SSH port 22 is CLOSED on the NSG and UFW. Access is
# through Cloudflare's edge network only -- the VM initiates an
# outbound tunnel, you connect via cloudflared access ssh.
#
# Create a tunnel token:
#   1. Go to https://one.dash.cloudflare.com/ → Networks → Tunnels
#   2. Create a tunnel, choose "cloudflared" as connector
#   3. Copy the token and paste it here
#
# Leave empty to use traditional NSG-based SSH (port 22 locked to IP).
# cloudflare_tunnel_token = ""
# cloudflare_tunnel_domain = "ssh.vm.yourdomain.com"
